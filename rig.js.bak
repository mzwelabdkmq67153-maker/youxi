      P({ rootRX: 0.10, spine02: [0.06, -0.40, 0], upperarm_R: [-1.45, 0, 0.60], forearm_R: [-0.45, 0, 0], upperarm_L: [0.55, 0, -0.10], forearm_L: [-0.75, 0, 0], thigh_L: [-0.45, 0, 0], thigh_R: [0.35, 0, 0], head: [0.04, -0.22, 0] }),
